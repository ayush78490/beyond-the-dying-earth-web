# Copy to .env. Leave the Supabase values empty to simulate X sign-in + signups locally.

# Supabase → Project Settings → API (the anon/public key is safe in the browser: RLS guards the table)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# mainnet (Robinhood Chain, 4663) or testnet (46630)
VITE_ROBINHOOD_NETWORK=mainnet
